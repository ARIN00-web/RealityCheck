{
  "name": "@realitycheck/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@realitycheck/config": "workspace:*",
    "@realitycheck/db": "workspace:*",
    "@realitycheck/explorer": "workspace:*",
    "@realitycheck/llm": "workspace:*",
    "@realitycheck/shared": "workspace:*",
    "@realitycheck/playwright-runner": "workspace:*",
    "bullmq": "5.56.0",
    "dotenv": "16.6.1",
    "ioredis": "5.6.1",
    "pino": "9.7.0"
  },
  "devDependencies": {
    "@types/node": "22.15.34",
    "tsx": "4.20.3",
    "vitest": "3.2.4"
  }
}

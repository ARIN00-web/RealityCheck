# Required by the API and worker.
DATABASE_URL=postgresql://realitycheck:realitycheck@localhost:5432/realitycheck?schema=public
REDIS_URL=redis://localhost:6380
ARTIFACT_STORAGE_PATH=./storage

# Optional: enables Gemini-assisted capabilities in a later implementation stage.
# Get a key from Google AI Studio. Deterministic browser execution does not require one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional runtime settings.
API_PORT=3001
WORKER_CONCURRENCY=1
RUN_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=15000
OBSERVATION_LIMIT=50
ARTIFACT_MAX_BYTES=5000000
EXPLORATION_ACTION_LIMIT=8
EXPLORATION_LLM_CALL_LIMIT=2
EXPLORATION_LLM_TIMEOUT_MS=5000

